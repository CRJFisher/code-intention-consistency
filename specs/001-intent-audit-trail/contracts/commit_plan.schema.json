{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "commit_plan.schema.json",
  "title": "Intention audit commit plan (v1)",
  "type": "object",
  "required": ["version", "ready", "diff_base", "diff_hash", "commits"],
  "properties": {
    "version": { "const": 1 },
    "ready": { "type": "boolean" },
    "diff_base": { "type": "string" },
    "diff_hash": { "type": "string" },
    "commits": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/CommitEntry" }
    }
  },
  "$defs": {
    "CommitEntry": {
      "type": "object",
      "required": ["intent_id", "functionality_intent_id", "subject", "patch"],
      "properties": {
        "intent_id": { "type": "string" },
        "intent_path": { "type": "string" },
        "functionality_intent_id": { "type": "string" },
        "functionality_intent_path": { "type": "string" },
        "subject": { "type": "string" },
        "body": { "type": "string" },
        "intent_confidence": { "type": ["number", "string"] },
        "evidence_tests": { "type": "array", "items": { "type": "string" } },
        "supporting_docs": { "type": "array", "items": { "type": "string" } },
        "patch": { "type": "string" }
      }
    }
  }
}

